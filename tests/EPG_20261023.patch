+   for i,v in enumerate(line):
+    a=line[i-stride] if i>=stride else 0;b=previous[i];c=previous[i-stride] if i>=stride else 0
+    predictor=[0,a,b,(a+b)//2,paeth(a,b,c)][filter];filtered.append((v-predictor)&255)
