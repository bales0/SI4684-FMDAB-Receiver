+void Core::reset() {
+  identityConflict=false;
+  stats=Stats{}; entryCount_=serviceCount_=0; directoryHash_=0; browseOffset_=0; focus_=0;
+  dirAssembly_.reset(); bodyAssembly_.reset(); phase_=0; clearCache();
